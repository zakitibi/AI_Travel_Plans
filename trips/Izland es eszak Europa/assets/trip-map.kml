      </Placemark>

    </Folder>

    <!-- ========================== -->
    <!-- HAZAÚT -->
    <!-- ========================== -->
    <Folder>
      <name>🇩🇰🇩🇪 Hazaút — Koppenhága + Hamburg + Frankfurt (júl. 29. – aug. 6.)</name>
      <Placemark>
        <name>Malmö — fotóstop (júl. 29.)</name>
        <description>Turning Torso (★4.3, Santiago Calatrava, 190 m), Stortorget (★4.3). Csak 45 perces fotóstop, éjszaka nincs.</description>
        <styleUrl>#return</styleUrl>
        <Point><coordinates>13.0038,55.6050,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Øresund Bridge — Malmö → Koppenhága</name>
        <description>★4.5 — 8 km híd + 4 km alagút. Díj: ~400 DKK (~54 EUR). Egyik legikonikusabb európai átkelő.</description>
        <styleUrl>#return</styleUrl>
        <Point><coordinates>12.8900,55.6200,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Koppenhága — 3 éjszaka (júl. 29. – aug. 1.)</name>
        <description>Nyhavn (★4.6), Rosenborg Slot (★4.6), Tivoli (★4.5), Christiansborg (★4.5), Little Mermaid (★4.0), Christiania (★4.3), Nørrebro, Torvehallerne (★4.5).</description>
        <styleUrl>#return</styleUrl>
        <Point><coordinates>12.5683,55.6761,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Louisiana Museum of Modern Art — Humlebæk (aug. 1.)</name>
        <description>★4.7 — Skandinávia legjobb modern múzeuma. Koppenhágától ~45 km észak. Calder, Giacometti, Warhol, Picasso. Szoborkert Øresund kilátással.</description>
